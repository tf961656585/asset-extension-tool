    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.3",
