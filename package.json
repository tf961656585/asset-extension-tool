{
  "name": "asset-extension-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 extension for saving, organizing, and AI-generating web images.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tf961656585/asset-extension-tool.git"
  },
